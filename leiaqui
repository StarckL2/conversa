      if(incoming.parents.includes(current.rev)){a[collection][a[collection].indexOf(current)]=incoming;continue;}
      const winner=current.rev>incoming.rev?current:incoming,loser=winner===current?incoming:current;
      a[collection][a[collection].indexOf(current)]=winner;
      const duplicate={...loser,id:'copy-'+loser.rev.slice(0,70)};
      if(!a[collection].some(e=>e.id===duplicate.id)){a[collection].push(duplicate);conflicts.push('Edições diferentes de '+(incoming.name||incoming.title||collection)+' foram preservadas em registros separados.');}
