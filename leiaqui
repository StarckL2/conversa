'use strict';
const Sync=(()=>{
  const collections={client:'clients',report:'reports',job:'jobs',payment:'payments',settings:'settings'};
  function records(workspace){const w=Workspace.validate(workspace);return [...w.quotes.map(q=>({kind:'quote',id:q.id,payload:q})),...Object.entries(w.rates).map(([id,payload])=>({kind:'rate',id,payload})),...Object.entries(collections).flatMap(([kind,key])=>w[key].map(payload=>({kind,id:payload.id,payload})))];}
  function decode(rows){const w=Workspace.empty();for(const r of rows){if(!Number.isSafeInteger(r.revision)||r.revision<1)throw new Error('Revisão do servidor inválida.');if(r.kind==='quote'){if(r.payload.id!==r.id)throw new Error('Identidade de orçamento inválida.');w.quotes.push(r.payload);}else if(r.kind==='rate')w.rates[r.id]=r.payload;else if(collections[r.kind]){if(r.payload.id!==r.id)throw new Error('Identidade de registro inválida.');w[collections[r.kind]].push(r.payload);}}return Workspace.validate(w);}
  async function exchange(local,call){
    let data=Workspace.validate(local),conflicts=[],catalog=[];
    for(let attempt=0;attempt<3;attempt++){
      const remote=await call('pull');catalog=remote.catalog;const merged=Workspace.merge(data,decode(remote.rows));data=merged.data;conflicts.push(...merged.conflicts);
      const versions=new Map(remote.rows.map(r=>[r.kind+':'+r.id,r]));let retry=false;
      for(const r of records(data)){
        const old=versions.get(r.kind+':'+r.id);if(old?.payload?.rev===r.payload.rev)continue;
        const result=await call('push',{record:r,revision:old?.revision??null});
        if(result?.conflict||!Array.isArray(result)||result.length!==1){retry=true;break;}
      }
      if(!retry)return {data,conflicts:[...new Set(conflicts)],catalog};
    }
    throw new Error('Os aparelhos estão alterando os mesmos dados. As versões locais foram mantidas; tente sincronizar novamente.');
  }
  return {records,decode,exchange};
})();
