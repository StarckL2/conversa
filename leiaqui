'use strict';
const Workspace=(()=>{
  const copy=x=>JSON.parse(JSON.stringify(x));
  const id=()=>crypto.randomUUID();
  const entities={clients:['name','phone','email','address','notes'],reports:['title','quoteId','clientId','date','findings','workDone','recommendations'],jobs:['title','quoteId','clientId','date','status','notes'],payments:['title','quoteId','date','amount','method','notes'],settings:['title','value']};
  const empty=()=>({version:2,quotes:[],rates:{},clients:[],reports:[],jobs:[],payments:[],settings:[]});
  function validRevision(r){return r&&typeof r.rev==='string'&&/^[\w-]{1,80}$/.test(r.rev)&&Array.isArray(r.parents)&&r.parents.length<=128&&r.parents.every(p=>typeof p==='string'&&/^[\w-]{1,80}$/.test(p));}
