const Quote = (() => {
  const money = value => new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(value/100);
  function number(value, label, max=1000000) {
    if (value === '' || value == null || typeof value === 'boolean') throw new Error(`Preencha ${label}.`);
    const n=Number(value);
    if (!Number.isFinite(n) || n<0 || n>max) throw new Error(`Valor inválido: ${label}.`);
    return n;
  }
  const cents = (value,label) => Math.round(number(value,label)*100);
  function calculate(draft) {
    if (!draft.items.length) throw new Error('Adicione ao menos um serviço.');
    let subtotal=0;
    for (const item of draft.items) {
      const quantity=number(item.quantity,'quantidade',99);
      if (!Number.isInteger(quantity) || quantity<1) throw new Error('Quantidade deve ser de 1 a 99.');
      if (!item.name.trim()) throw new Error('Dê um nome ao serviço.');
      const price=cents(item.price,`preço de ${item.name}`);
      if (!price) throw new Error(`Defina um preço maior que zero para ${item.name}.`);
      subtotal+=price*quantity;
    }
    const minimum=cents(draft.minimum,'mínimo'), minimumAdjustment=Math.max(0,minimum-subtotal);
    const labor=subtotal+minimumAdjustment;
    const surcharge=Math.round(labor*number(draft.percent,'adicional percentual',100)/100);
    const materials=cents(draft.materials,'materiais'), travel=cents(draft.travel,'deslocamento'), discount=cents(draft.discount,'desconto');
    if (discount>labor+surcharge) throw new Error('O desconto não pode superar a mão de obra com adicional.');
    if (draft.percent>0 && !draft.surchargeReason.trim()) throw new Error('Descreva o motivo do adicional.');
    const total=labor+surcharge+materials+travel-discount;
    if (total<=0) throw new Error('O total deve ser maior que zero.');
    return {subtotal,minimumAdjustment,labor,surcharge,materials,travel,discount,total};
  }
  function message(draft) {
    const r=calculate(draft);
    if (!draft.client.trim() || !draft.location.trim() || !draft.scope.trim() || !draft.validity.trim()) throw new Error('Preencha cliente, local, escopo e validade antes de enviar.');
    const lines=[`${draft.kind} · ALTIMAX Elétrica`, `Referência: ${draft.reference}`, `Cliente: ${draft.client}`,`Local: ${draft.location}`, '', 'Serviços:'];
    draft.items.forEach(i=>lines.push(`• ${i.quantity} × ${i.name} — ${money(cents(i.price,'preço')*i.quantity)}`));
    if(r.minimumAdjustment)lines.push(`Complemento de atendimento mínimo: ${money(r.minimumAdjustment)}`);
    if(r.surcharge)lines.push(`Adicional (${draft.surchargeReason}): ${money(r.surcharge)}`);
    lines.push(r.materials ? `Materiais incluídos no total: ${money(r.materials)}` : 'Materiais: fornecidos pelo cliente; não incluídos no valor.');
    if(r.travel)lines.push(`Deslocamento: ${money(r.travel)}`);
    if(r.discount)lines.push(`Desconto: ${money(r.discount)}`);
    lines.push('',`TOTAL: ${money(r.total)}`,'',`Escopo: ${draft.scope}`,`Pagamento: ${draft.payment}`,`Validade: ${draft.validity}`,`Agendamento: ${draft.schedule}`);
    if(draft.notes.trim())lines.push(`Observações: ${draft.notes}`);
    if(draft.kind==='Pré-orçamento')lines.push('Estimativa para o escopo descrito. Condições da instalação serão confirmadas antes de fechar o orçamento.');
    lines.push('Qualquer serviço adicional será combinado antes da execução.','', 'Marcello Almeida · (21) 98453-2692','Engenheiro Eletricista · RNP 2022776690 · CREA-RJ');
    return lines.join('\n');
  }
  function parseRequest(text, services) {
    const match=String(text).match(/ALT1:([^\s]+)/);
    if (!match) throw new Error('Cole a mensagem com a referência ALT1 recebida do site.');
    const tokens=match[1].split(',');
    if(tokens.length>services.length)throw new Error('Pedido muito extenso.');
    const seen=new Set();
    return tokens.map(token=>{
      const m=token.match(/^(S\d{3})x([1-9]\d?)$/);
      const service=m && services.find(s=>s.id===m[1]);
      if(!service || seen.has(service.id))throw new Error('Referência inválida ou serviço repetido.');
      seen.add(service.id);
      return {id:service.id,name:service.name,quantity:Number(m[2]),price:null};
    });
  }
  function validateDraft(value) {
    if(!value || value.version!==1 || !Array.isArray(value.items) || value.items.length>200)throw new Error('Arquivo de rascunho inválido.');
    const clean={version:1};
    for(const key of ['client','location','phone','reference','kind','scope','validity','schedule','payment','notes','surchargeReason']){
      if(typeof value[key]!=='string' || value[key].length>5000)throw new Error(`Campo inválido: ${key}.`);
      clean[key]=value[key];
    }
    if(!['Pré-orçamento','Orçamento'].includes(clean.kind))throw new Error('Tipo de orçamento inválido.');
    for(const key of ['minimum','percent','materials','travel','discount'])clean[key]=number(value[key],key,key==='percent'?100:1000000);
    const ids=new Set();
    clean.items=value.items.map(i=>{
      if(!i || typeof i.id!=='string' || typeof i.name!=='string' || !i.name.trim() || i.name.length>500 || !/^[\w-]{1,80}$/.test(i.id) || ids.has(i.id))throw new Error('Item de rascunho inválido.');
      ids.add(i.id);
      const quantity=number(i.quantity,'quantidade',99);
      if(!Number.isInteger(quantity)||quantity<1)throw new Error('Quantidade inválida.');
      return {id:i.id,name:i.name,quantity,price:i.price==null || i.price==='' ? null : number(i.price,'preço')};
    });
    return clean;
  }
  function whatsappUrl(phone,text) {
    let digits=String(phone).replace(/\D/g,'');
    if(digits.length===10 || digits.length===11)digits='55'+digits;
    if(!/^55[1-9]\d{9,10}$/.test(digits))throw new Error('Informe o WhatsApp do cliente com DDD (10 ou 11 dígitos).');
    return `https://wa.me/${digits}?text=${encodeURIComponent(text)}`;
  }
  return {money,calculate,message,parseRequest,validateDraft,whatsappUrl};
})();
