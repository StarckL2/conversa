    }
    for(const [key,r] of Object.entries(value.rates)){
      if(!/^S\d{3}$/.test(key)||!validRevision(r)||typeof r.price!=='number'||!Number.isFinite(r.price)||r.price<=0||r.price>1000000)throw new Error('Preço inválido no arquivo.');
      result.rates[key]={price:Math.round(r.price*100)/100,rev:r.rev,parents:[...r.parents]};
    }
    for(const [collection,fields] of Object.entries(entities)){
      const entries=value[collection]??[];if(!Array.isArray(entries)||entries.length>3000)throw new Error('Lista de dados inválida.');const seen=new Set();
      result[collection]=entries.map(e=>{
        if(!e||!validRevision(e)||typeof e.id!=='string'||!/^[\w-]{1,80}$/.test(e.id)||seen.has(e.id)||!Number.isFinite(Date.parse(e.updatedAt)))throw new Error('Registro inválido.');seen.add(e.id);
        const clean={id:e.id,rev:e.rev,parents:[...e.parents],updatedAt:e.updatedAt,deleted:!!e.deleted};
        for(const f of fields){if(typeof e[f]!=='string'||e[f].length>5000)throw new Error('Campo inválido: '+f);clean[f]=e[f];}
