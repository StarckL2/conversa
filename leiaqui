  }
  function revision(previous){return {rev:id(),parents:previous?[...previous.parents,previous.rev].slice(-128):[]};}
  function updateQuote(workspace,draft,quoteId,status='rascunho'){
    const previous=workspace.quotes.find(q=>q.id===quoteId);
    const entry={id:quoteId||id(),...revision(previous),status,updatedAt:new Date().toISOString(),draft:Quote.validateDraft(draft)};
